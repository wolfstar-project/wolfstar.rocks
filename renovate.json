{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"prCreation": "immediate",
	"extends": ["github>wolfstar-project/.github:wolfstar-renovate"],
	"git-submodules": {
		"enabled": true
	},
	"packageRules": [
		{
			"groupName": "vite dependencies",
			"groupSlug": "vite",
			"matchPackageNames": ["vite", "@voidzero-dev/vite-plus-core", "/^@vitejs//", "/^vite-/"]
		},
		{
			"description": "vite-plus bundles one vitest. The catalog must match it, so vite-plus bumps vitest and Renovate leaves it alone.",
			"matchPackageNames": ["vitest", "/^@vitest//"],
			"enabled": false
		},
		{
			"description": "The Prisma packages follow the bot's contract (vendor/wolfstar). A newer rc breaks the typed-json contract pack. Bump them with the submodule.",
			"matchPackageNames": ["prisma", "/^@prisma//"],
			"enabled": false
		},
		{
			"description": "vue-tsc 3.3.14 reports false type errors in v-else-if chains and a nullable ref in two templates. Remove this rule after a fixed release.",
			"matchPackageNames": ["vue-tsc"],
			"enabled": false
		},
		{
			"extends": ["packages:test"],
			"matchPackageNames": ["c8", "happy-dom", "jsdom"],
			"groupName": "test packages"
		},
		{
			"extends": ["packages:linters"],
			"matchPackageNames": ["commitlint", "knip", "publint"],
			"groupName": "all linters"
		},
		{
			"groupName": "nuxt core",
			"groupSlug": "nuxt",
			"matchPackageNames": [
				"@nuxt/cli",
				"@nuxt/kit",
				"@nuxt/module-builder",
				"@nuxt/schema",
				"@nuxt/test-utils",
				"@nuxt/vite-builder",
				"@nuxt/webpack-builder",
				"nuxi",
				"nuxt",
				"vue"
			],
			"schedule": ["at any time"]
		}
	]
}
