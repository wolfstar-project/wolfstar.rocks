
# ===================================
# Authentication
# ===================================
# Better Auth runs on the WolfStar bot API (clientOnly). Configure Discord OAuth
# and Better Auth secrets on the bot, not on this Nuxt app.
# Bot Discord callback (local): http://localhost:8282/api/auth/callback/discord
# See https://better-auth.nuxt.dev/guides/external-auth-backend

# Discord OAuth Application Client ID (optional on Nuxt; used by legacy sapphire helpers)
NUXT_OAUTH_DISCORD_CLIENT_ID=

# Discord OAuth Application Client Secret (optional on Nuxt; sapphire cookie encryption)
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# Discord OAuth Application Redirect URL (configure on the bot Better Auth server)
NUXT_OAUTH_DISCORD_REDIRECT_URL=

# Discord bot token for server-side Discord API calls (guilds, members, roles)
NUXT_OAUTH_DISCORD_BOT_TOKEN=

# Not used in clientOnly mode (auth secret lives on the bot). Kept for local
# tooling that still reads the key — leave blank.
# NUXT_BETTER_AUTH_SECRET=

# Session cookie name — unused in clientOnly mode (bot sets the session cookie).
# NUXT_SESSION_COOKIE_NAME=

# Nuxt Studio GitHub OAuth credentials (required for production publishing;
# also used when testing the production auth flow locally with studio.dev = false).
# Configure callback URLs for each environment, e.g.:
#   http://localhost:3000/__nuxt_studio/auth/github
#   https://wolfstar.rocks/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=

# Secret for generating OG images (generate a secure random string)
# You can use: openssl rand -base64 32
NUXT_IMAGE_PROXY_SECRET=
# ===================================
# Storage Configuration (Required)
# ===================================

# Production only
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_NAMESPACE_ID=
NUXT_CLOUDFLARE_API_TOKEN=

# ===================================
# Website Environment (Required)
# WolfStar bot API origin used by `$api` and Better Auth client (`app/auth.config.ts`).
# Production/internal: https://api.wolfstar.rocks (default when unset)
# Local bot instance:  http://localhost:8282
# Bot must allow this frontend origin in CORS + trustedOrigins (credentials).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8282

# Optional: sapphire-plugin-api cookie name (legacy hop). Defaults to SAPPHIRE_AUTH.
# NUXT_BOT_API_AUTH_COOKIE=SAPPHIRE_AUTH

# Frontend site URL (e.g., https://wolfstar.rocks) — NOT the auth backend
NUXT_PUBLIC_SITE_URL=
# ===================================

# Enable PWA in development mode (true or false)
VITE_DEV_PWA=false

# ===================================
# Sentry (Optional)
# ===================================

# Sentry config for Auth Token
SENTRY_AUTH_TOKEN=

# Sentry config for Project Name
SENTRY_PROJECT=

# Sentry config for organization
SENTRY_ORG=

# Sentry DSN for error tracking:
SENTRY_DSN=

# Sentry trace sampling rate: a number from 0 to 1 (0 = no traces, 1 = all).
# Defaults to 0.2 when unset; invalid values fall back to the default.
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# ===================================
# Port and Hostname (Optional)
# ===================================

# uncomment this if you want change port or hostname
# PORT=8281
# HOSTNAME="localhost"

# ===================================
# Tolgee (optional — CLI push/pull)
# ===================================
# Project API Key or PAT for project 33768 (Wolfstar Website).
# A PAT from `tolgee login` also works. Never commit the real value.
TOLGEE_API_KEY=

# ===================================
# Audit log (dev only)
# ===================================
# No configuration required. When NODE_ENV=development, audit events are written
# to .audit/ via evlog/signed + FS drain (hash-chain, local inspection only).
# In production, audit events are handled by the WolfStar bot / shared API.
