// Mirror of the WolfStar bot's V7 database contract
// (wolfstar-project/wolfstar → projects/database/src/prisma8/contract.prisma),
// plus the dashboard-owned `Modules` table.
//
// The bot owns these tables: keep this file in sync with the contract rather
// than reshaping it here, so both services read the same columns.

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  // URL is provided via prisma.config.ts (CLI) and `@prisma/adapter-pg` (runtime)
}

model Guild {
  id BigInt @id

  modules Modules?

  cases       ModerationAction[]
  stickyRoles StickyRole[]
}

/// Per-guild feature toggles, in the spirit of Dyno's module switches: the
/// dashboard flips them, the bot reads them before running a subsystem.
///
/// Every dashboard-managed settings table hangs off this one, so a module row
/// is the parent record for its subsystem's configuration: deleting it takes
/// the subsystem's settings with it.
model Modules {
  id    BigInt @id
  /// The guild entry is from.
  guild Guild  @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Message filters and their escalation rules.
  automod    Boolean @default(true)
  /// Manual moderation actions and their case history.
  moderation Boolean @default(true)
  /// Server event logging.
  logs       Boolean @default(true)
  /// Command handling, including per-guild command availability.
  commands   Boolean @default(true)
  /// Role automation: initial roles and sticky roles.
  roles      Boolean @default(true)

  autoModerationSettings GuildAutoModeration?
  logSettings            GuildLogs?
  moderationSettings     GuildModeration?
  permissions            GuildPermissions?
  roleSettings           GuildRoles?
}

/// Permission nodes: per-command allow and deny lists that grant or withhold
/// access beyond a member's Discord permissions.
///
/// The V7 contract dropped the V6 `permissions.users` / `permissions.roles`
/// columns, but `canManage()` still honours them, so the dashboard keeps them
/// in a table of its own. The bot has to read this table for the nodes to
/// affect command execution too.
model GuildPermissions {
  id      BigInt  @id
  /// The module entry is from.
  modules Modules @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The per-user permission nodes.
  /// [PermissionNodeEntries]
  users Json @default("[]")
  /// The per-role permission nodes.
  /// [PermissionNodeEntries]
  roles Json @default("[]")
}

model GuildModeration {
  id      BigInt  @id
  /// The module entry is from.
  modules Modules @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The moderation logs channel.
  channelId     BigInt? @map("channel_id")
  /// Whether or not bans issued manually should be logged.
  trackBans     Boolean @default(false) @map("track_bans")
  /// Whether or not timeouts issued manually should be included.
  trackTimeouts Boolean @default(false) @map("track_timeouts")
}

model GuildAutoModeration {
  id      BigInt  @id
  /// The module entry is from.
  modules Modules @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The moderation logs channel.
  channelId   BigInt? @map("channel_id")
  /// Whether or not to track Discord's native automod actions.
  trackNative Boolean @default(false) @map("track_native")

  attachments GuildAutoModerationAttachments?
  capitals    GuildAutoModerationCapitals?
  invites     GuildAutoModerationInvites?
  links       GuildAutoModerationLinks?
  mentions    GuildAutoModerationMentions?
  newlines    GuildAutoModerationNewlines?
  words       GuildAutoModerationWords?
}

enum GuildAutoModerationHardAction {
  VoiceKick
  Warning
  Timeout
  Kick
  Softban
  Ban
}

model GuildAutoModerationAttachments {
  id     BigInt              @id
  /// The parent where all automod information is at.
  parent GuildAutoModeration @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Whether or not the subsystem is enabled.
  enabled Boolean?

  /// The action to do in each infraction. Holds a bitfield value, where:
  ///
  /// - 1st bit (0b00X): Whether or not to delete the message.
  /// - 2nd bit (0b0X0): Whether or not to send an alert to the channel.
  /// - 3rd bit (0bX00): Whether or not to log the infraction.
  softAction Int @map("soft_action")

  /// The action to do once the threshold is exceeded.
  hardAction         GuildAutoModerationHardAction @map("hard_action")
  /// The duration in seconds of the hard action. Only applicable to Warning, Timeout, and Ban.
  hardActionDuration Int?                          @map("hard_action_duration")

  /// The amount of infractions a user can do before triggering the hard action.
  thresholdMaximum  Int @map("threshold_maximum")
  /// The amount of time in seconds to pool the amount of infractions.
  thresholdDuration Int @map("threshold_duration")

  /// The roles that are ignored by this subsystem.
  ignoredRoles    BigInt[] @default([]) @map("ignored_roles")
  /// The channels that are ignored by this subsystem.
  ignoredChannels BigInt[] @default([]) @map("ignored_channels")
}

model GuildAutoModerationCapitals {
  id     BigInt              @id
  /// The parent where all automod information is at.
  parent GuildAutoModeration @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Whether or not the subsystem is enabled.
  enabled Boolean?

  /// The action to do in each infraction. Holds a bitfield value.
  softAction Int @map("soft_action")

  /// The action to do once the threshold is exceeded.
  hardAction         GuildAutoModerationHardAction @map("hard_action")
  /// The duration in seconds of the hard action.
  hardActionDuration Int?                          @map("hard_action_duration")

  /// The amount of infractions a user can do before triggering the hard action.
  thresholdMaximum  Int @map("threshold_maximum")
  /// The amount of time in seconds to pool the amount of infractions.
  thresholdDuration Int @map("threshold_duration")

  /// The minimum amount of characters a message must have to be checked.
  minimum Int
  /// The maximum percentage of capital letters allowed in a message.
  maximum Int

  /// The roles that are ignored by this subsystem.
  ignoredRoles    BigInt[] @default([]) @map("ignored_roles")
  /// The channels that are ignored by this subsystem.
  ignoredChannels BigInt[] @default([]) @map("ignored_channels")
}

